{
  "name": "qe-group-draw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css:build": "bunx --bun postcss ./src/tailwind.css -o ./src/styles.css",
    "css:dev": "bunx --bun postcss ./src/tailwind.css -o ./src/styles.css --watch",
    "dev": "bun run css:dev & bun ./src/index.html",
    "serve:live": "bun ./src/server.ts",
    "build": "bun run css:build && bun build ./src/index.html --outdir ./dist --target browser --minify",
    "build:archive": "bun ./scripts/build-archive-page.tsx ./dist",
    "build:server": "rm -rf ./server-dist && bun build ./src/server.ts --compile --target=bun-linux-x64-modern --outfile ./server-dist/qe-group-draw-live",
    "build:all": "bun run build && bun run build:archive && bun run build:server",
    "test": "bun test",
    "test:parallel": "bun test --parallel",
    "test:changed": "bun test --changed",
    "format": "bun fmt .",
    "format:check": "bun fmt . --check",
    "lint": "bunx --bun oxlint --type-aware .",
    "check": "bun check --no-script",
    "check:ci": "bun run check && bun run format:check && bun run lint && bun run test:parallel",
    "verify": "bun run check && bun run format:check && bun run lint && bun run test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lightningcss": "^1.33.0",
    "lightningcss-darwin-x64": "^1.33.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "tailwindcss": "^4.3.3"
  }
}
